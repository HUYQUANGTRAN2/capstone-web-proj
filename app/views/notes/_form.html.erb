<%= form_with(model: note, data: { turbo: false }) do |form| %>

  <% if note.errors.any? %>
    <div class="error-box">
      <% note.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :body %>
    <%= form.rich_text_area :body %>
  </div>

  <div class="field checkbox-field">
    <%= form.check_box :pinned %>
    <%= form.label :pinned %>
  </div>

  <div>
    <%= form.submit class: "button" %>
  </div>

<% end %>
