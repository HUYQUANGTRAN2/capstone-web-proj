<% content_for :title, "Pinned" %>

<div class="notes-page">
  <div>

    <% if @notes.any? %>
      <div class="notes-list">
        <% @notes.each do |note| %>

          <%= link_to note_path(note), class: "note-card" do %>

            <div class="note-card-header">
              <h2><%= note.title %></h2>
              <span>📌</span>
            </div>

            <div class="note-preview">
              <%= note.body %>
            </div>

          <% end %>

        <% end %>
      </div>
    <% else %>
      <p>No pinned notes yet.</p>
    <% end %>
  </div>

  <% if signed_in? %>
    <div class="bottom-actions">
      <%= button_to "Log Out",
          sign_out_path,
          method: :delete,
          class: "danger-button full-width-button" %>
    </div>
  <% end %>
</div>
