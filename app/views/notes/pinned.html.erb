<% content_for :title, "Pinned" %>

<div class="notes-page">
  <div>
    <h1>Pinned Notes</h1>

    <% if @notes.any? %>
      <div class="notes-list">
        <% @notes.each do |note| %>
          <%= link_to note_path(note), class: "note-card" do %>
            <h2><%= note.title %></h2>
            <p><%= truncate(strip_tags(note.body.to_s), length: 100) %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p>No pinned notes yet.</p>
    <% end %>
  </div>

  <div class="bottom-actions">
    <% if signed_in? %>
      <%= button_to "Log Out",
          sign_out_path,
          method: :delete,
          class: "danger-button full-width-button" %>
    <% else %>
      <%= link_to "Sign In",
          sign_in_path,
          class: "button full-width-button" %>
    <% end %>
  </div>
</div>
