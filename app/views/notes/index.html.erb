<% content_for :title, "Notes" %>

<div class="page-header">
  <%= link_to "New", new_note_path, class: "button" %>
</div>

<% if @notes.any? %>
  <div class="notes-list">
    <% @notes.each do |note| %>
      <%= link_to note_path(note), class: "note-card" do %>

        <div class="note-card-header">
          <h2><%= note.title %></h2>

          <% if note.pinned? %>
            <span>📌</span>
          <% end %>
        </div>

        <p>
          <%= truncate(note.body, length: 120) %>
        </p>

      <% end %>
    <% end %>
  </div>
<% else %>
  <p>No notes yet.</p>
<% end %>
