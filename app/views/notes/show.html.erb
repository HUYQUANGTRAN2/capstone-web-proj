<p style="color: green"><%= notice %></p>
<% content_for :title, (@note&.title || "Note") %>
<div class="page-header">
  <div>
    <% if @note.pinned? %>
      <p>📌 Pinned note</p>
    <% end %>
  </div>

  <%= link_to "Edit", edit_note_path(@note), class: "button" %>
</div>

<div class="note-body">
  <%= @note.body %>
</div>

<div class="actions">
  <%= link_to "Back to notes", notes_path, class: "secondary-button" %>

  <%= button_to "Delete note", @note,
      method: :delete,
      class: "danger-button",
      data: { turbo_confirm: "Are you sure you want to delete this note?" } %>
</div>
